{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohrisk:schema:notices-evidence:1.0.0",
  "title": "Ohrisk notices evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "urn:ohrisk:schema:notices-evidence:1.0.0"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "packages": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purl"
        ],
        "properties": {
          "purl": {
            "type": "string",
            "minLength": 1
          },
          "copyright": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "licenseFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "noticeFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
